# Slidekick — bring-your-own LLM
# Copy to .env.local and fill in. Or skip — the in-app Settings panel works too.

# Provider: openai-compatible | anthropic
VITE_LLM_PROVIDER=anthropic

# -------- For VITE_LLM_PROVIDER=anthropic --------
# Native Anthropic Messages API. Use this if you have a key from console.anthropic.com.
VITE_LLM_BASE_URL=https://api.anthropic.com/v1
VITE_LLM_API_KEY=sk-ant-...
VITE_LLM_MODEL=claude-sonnet-4-6
# Other Claude options: claude-opus-4-7, claude-haiku-4-5-20251001

# -------- For VITE_LLM_PROVIDER=openai-compatible --------
# Any OpenAI-compatible /v1/chat/completions endpoint:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
#   LM Studio:   http://localhost:1234/v1
# VITE_LLM_BASE_URL=https://api.openai.com/v1
# VITE_LLM_API_KEY=sk-...
# VITE_LLM_MODEL=gpt-4o-mini

# Default visual theme: minimal | dark | corporate
VITE_DEFAULT_THEME=minimal

# Maximum slides per deck (1-10)
VITE_MAX_SLIDES=8
